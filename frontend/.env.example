# Copy to .env and adjust if needed.

# Base URL of the Yajnaseni Spring Boot backend.
VITE_API_BASE=http://localhost:8080

# Comma-separated voice-input locales offered by the Web Speech API selector.
# kn-IN = Kannada, hi-IN = Hindi, ta-IN = Tamil, te-IN = Telugu, en-IN = English (India).
VITE_VOICE_LANGS=en-IN,hi-IN,kn-IN,ta-IN,te-IN
